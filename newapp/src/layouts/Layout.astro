---
import "$lib/styles/global.css";

import BaseHead from "$lib/components/BaseHead.astro";
import Header from "$lib/components/Header.astro";
import Footer from "$lib/components/Footer.astro";
import { LD_JSON_DATA } from "../consts";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/custom.js"></script>
    <script src="https://www.googletagmanager.com/gtag/js?id=G-33PP6GNTHT"></script>
    <script src="../scripts/google-tag.js"></script>
    <!-- LD JSON Data -->
    <script type="application/ld+json" set:html={JSON.stringify(LD_JSON_DATA)} />
  </body>
</html>

<script>
  const theme = localStorage.getItem("theme");
  const htmlElement = document.getElementsByTagName("html");
  if (theme == "dark") {
    htmlElement && htmlElement[0].classList.add("dark", "bg-black");
  } else {
    htmlElement && htmlElement[0].classList.remove("dark", "bg-black");
  }
</script>
